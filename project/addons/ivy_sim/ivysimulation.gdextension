android.arm32.double.release = "bin/android/libivysim.android.template_release.arm32.double.so"

web.wasm32.single.debug = "bin/web/libivysim.web.template_debug.wasm32.nothreads.wasm"
web.wasm32.double.debug = "bin/web/libivysim.web.template_debug.wasm32.double.nothreads.wasm"
web.wasm32.single.release = "bin/web/libivysim.web.template_release.wasm32.nothreads.wasm"
