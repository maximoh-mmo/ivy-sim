android.arm64.single.debug = "bin/android/libivysim.android.template_debug.arm64.so"
android.arm64.double.debug = "bin/android/libivysim.android.template_debug.arm64.double.so"
android.arm64.single.release = "bin/android/libivysim.android.template_release.arm64.so"
android.arm64.double.release = "bin/android/libivysim.android.template_release.arm64.double.so"

android.arm32.single.debug = "bin/android/libivysim.android.template_debug.arm32.so"
android.arm32.double.debug = "bin/android/libivysim.android.template_debug.arm32.double.so"
