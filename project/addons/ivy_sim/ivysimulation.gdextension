linux.rv64.single.debug = "bin/linux/libivysim.linux.template_debug.rv64.so"
linux.rv64.double.debug = "bin/linux/libivysim.linux.template_debug.rv64.double.so"
linux.rv64.single.release = "bin/linux/libivysim.linux.template_release.rv64.so"
linux.rv64.double.release = "bin/linux/libivysim.linux.template_release.rv64.double.so"

android.x86_64.single.debug = "bin/android/libivysim.android.template_debug.x86_64.so"
android.x86_64.double.debug = "bin/android/libivysim.android.template_debug.x86_64.double.so"
