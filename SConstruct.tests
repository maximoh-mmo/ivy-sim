#!/usr/bin/env python
import os
import glob

godot_cpp_bin = "godot-cpp/bin"
msvc_libs = glob.glob(os.path.join(godot_cpp_bin, "*.lib")) if os.path.isdir(godot_cpp_bin) else []
unix_libs = glob.glob(os.path.join(godot_cpp_bin, "libgodot-cpp*.a")) if os.path.isdir(godot_cpp_bin) else []

if os.name == "nt" and msvc_libs:
    env = Environment(tools=["msvc", "mslink", "mslib"], TARGET_ARCH="amd64")
else:
    env = Environment(tools=["default"])

is_msvc = "msvc" in env.get("TOOLS", []) or "cl" in os.path.basename(env.subst("$CXX")).lower()
if is_msvc:
    env.Append(CCFLAGS=["/EHsc", "/std:c++17", "/Zc:__cplusplus", "/MT"])
else:
    env.Append(CCFLAGS=["-std=c++17"])

if ARGUMENTS.get("precision") == "double":
    env.Append(CPPDEFINES=["REAL_T_IS_DOUBLE"])

env.Append(CPPPATH=[
    "src",
    "tests/native",
    "godot-cpp/include",
    "godot-cpp/gen/include",
])

if os.path.isdir(godot_cpp_bin):
    env.Append(LIBPATH=[godot_cpp_bin])
    if is_msvc and msvc_libs:
        libname = os.path.splitext(os.path.basename(msvc_libs[0]))[0]
        env.Append(LIBS=[libname])
    elif unix_libs:
        libfile = os.path.basename(unix_libs[0])
        libname = libfile[3:-2] if libfile.startswith("lib") and libfile.endswith(".a") else os.path.splitext(libfile)[0]
        env.Append(LIBS=[libname])

sources = [
    "tests/native/test_main.cpp",
    "tests/native/ivy_random_tests.cpp",
    "tests/native/ivy_wall_tests.cpp",
    "tests/native/ivy_pixel_sampler_tests.cpp",
    "tests/native/ivy_growth_graph_tests.cpp",
    "src/random/ivy_random.cpp",
    "src/environment/ivy_wall.cpp",
    "src/environment/ivy_pixel_sampler.cpp",
    "src/growth/ivy_point.cpp",
    "src/growth/ivy_growth_graph.cpp",
    "tests/native/ivy_growth_solver_tests.cpp",
    "src/environment/ivy_surface_sampler.cpp",
    "src/mesh/ivy_mesh_generator.cpp",
    "src/growth/ivy_growth_solver.cpp",
    "tests/native/ivy_mesh_generator_tests.cpp",
]

test_program = env.Program(
    target="bin/ivy_tests",
    source=sources,
)

Default(test_program)
